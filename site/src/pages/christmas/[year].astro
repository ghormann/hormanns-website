---
import { getCollection, render } from 'astro:content';
import ChristmasLayout from '../../layouts/ChristmasLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Img from '../../components/Img.astro';
import VisitFacts from '../../components/VisitFacts.astro';
import DisplayMap from '../../components/DisplayMap.astro';
import CoverageList from '../../components/CoverageList.astro';
import { coverageFor, coverageSchema } from '../../lib/coverage';
import YouTubeGrid from '../../components/YouTubeGrid.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import StatBlock from '../../components/StatBlock.astro';
import FavDisplays from '../../components/FavDisplays.astro';
import { season, SHOW_HOURS_TEXT, isoDate } from '../../lib/displayYears';
import { DISPLAY, origin, absolute, place, person, breadcrumbList, touristAttraction, graph } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('christmas', ({ data }) => !data.draft);
  const sorted = entries.sort((a, b) => a.data.year - b.data.year);

  const latestYear = sorted[sorted.length - 1]?.data.year;

  return sorted.map((entry, i) => ({
    params: { year: String(entry.data.year) },
    props: {
      entry,
      isLatestYear: entry.data.year === latestYear,
      prev: sorted[i - 1]
        ? { year: sorted[i - 1].data.year, slug: sorted[i - 1].id }
        : undefined,
      next: sorted[i + 1]
        ? { year: sorted[i + 1].data.year, slug: sorted[i + 1].id }
        : undefined,
    },
  }));
}

const { entry, prev, next, isLatestYear } = Astro.props;
const { Content } = await render(entry);
const { title, year, heroImage, heroImageAlt, stats, videos, photos, showFavDisplays } = entry.data;

// Build a unique meta description for this year's page.
const pixelCount = typeof stats?.pixel_count === 'number' ? stats.pixel_count : undefined;
const description: string =
  entry.data.description ??
  (pixelCount
    ? `Hormann Christmas Light Display ${year} — ${pixelCount.toLocaleString()} pixels synchronized to music in Liberty Township, Ohio.`
    : (entry.data.short_description ?? `Hormann animated Christmas light display, ${year}, Liberty Township, Ohio.`));

// The <title> targets how people search for the display; the <h1> keeps the
// friendlier wording from the content file.
const seoTitle = `Christmas Lights ${year} — The Hormanns, Liberty Township OH`;

// ogImage: use heroImage if present (root-relative or absolute).
const ogImage = heroImage ?? undefined;

// Canonical host comes from astro.config.mjs (`site`) so structured data can never
// drift from the canonical/sitemap URLs.
const siteBase = origin(Astro.site);

// Press that ran during this season, shown at the foot of the page.
const yearCoverage = coverageFor(year);

const author = person(siteBase, 'Greg Hormann', 'greg');
const pageUrl = `${siteBase}/christmas/${year}/`;
const absHero = heroImage ? absolute(siteBase, heroImage) : undefined;

// Only the season that is actually running (or about to) gets treated as live.
// `isLatestYear` alone would keep advertising an Event from a season that ended
// months ago simply because next year's content file doesn't exist yet.
const currentSeason = season();
const isCurrentSeason = isLatestYear && year >= currentSeason.year;

// Every year page is an archival CreativeWork describing that season's display.
const creativeWork: Record<string, unknown> = {
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#display`,
  name: `Hormann Christmas Light Display ${year}`,
  description,
  datePublished: isoDate(`${year}-12-01`),
  contentLocation: place,
  author,
  url: pageUrl,
  ...(absHero ? { image: absHero } : {}),
  ...(yearCoverage.length > 0 ? { subjectOf: coverageSchema(yearCoverage, absHero) } : {}),
};

// The live Event is canonically on /christmas/visit/; the current season's page
// references that node rather than declaring a competing copy of it.
const currentEvent = isCurrentSeason
  ? {
      '@type': 'Event',
      '@id': `${siteBase}/christmas/visit/#event-${currentSeason.year}`,
      name: `Hormann Christmas Light Display ${currentSeason.year}`,
      description: `Free Christmas light show in Liberty Township, Ohio, with music on ${DISPLAY.fmFrequency} or outdoor speakers. Open nightly ${SHOW_HOURS_TEXT} from ${currentSeason.openText} through ${currentSeason.closeText}.`,
      startDate: currentSeason.startDateIso,
      endDate: currentSeason.endDateIso,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: place,
      organizer: author,
      performer: author,
      isAccessibleForFree: true,
      url: `${siteBase}/christmas/visit/`,
      ...(absHero ? { image: absHero } : {}),
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        validFrom: currentSeason.startDateIso,
        url: `${siteBase}/christmas/visit/`,
      },
    }
  : null;

// Each song video becomes a VideoObject. There are dozens per season and they
// are the least contested rich result available to this site.
const videoObjects = videos.map(v => ({
  '@type': 'VideoObject',
  name: `${v.title} — Hormann Christmas Light Display ${year}`,
  description: `${v.title}, sequenced to the Hormann animated Christmas light display in Liberty Township, Ohio (${year} season).`,
  thumbnailUrl: v.thumb ?? `https://img.youtube.com/vi/${v.id}/maxresdefault.jpg`,
  uploadDate: isoDate(`${year}-12-01`),
  contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
  creator: author,
}));

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Christmas Display', path: '/christmas/' },
];

const jsonLd = graph(
  creativeWork,
  currentEvent,
  touristAttraction(siteBase, absHero),
  ...videoObjects,
  breadcrumbList(siteBase, [...crumbs, { name: String(year), path: `/christmas/${year}/` }]),
);
---

<ChristmasLayout title={seoTitle} description={description} ogImage={ogImage} ogImageAlt={heroImageAlt ?? undefined} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} current={String(year)} />

  <!-- Hero heading strip -->
  <div
    class="rounded-lg px-6 py-4 mb-4 -mx-2"
    style="background-color: var(--color-accent);"
  >
    <h1 class="text-3xl font-bold m-0" style="color: var(--color-heading);">
      {title}
    </h1>
  </div>

  <!-- Year navigation -->
  <nav class="grid grid-cols-3 items-center mb-6 text-sm" style="font-family: var(--font-sans);">
    <div>
      {prev && (
        <a
          href={`/christmas/${prev.year}/`}
          class="flex items-center gap-1 font-medium px-3 py-1 rounded-full transition-opacity hover:opacity-80 w-fit"
          style="background-color: var(--color-accent); color: var(--color-heading);"
        >
          ← {prev.year}
        </a>
      )}
    </div>

    <div class="flex justify-center">
      <a
        href="/christmas/"
        class="font-medium px-3 py-1 rounded-full border transition-opacity hover:opacity-80"
        style="border-color: var(--color-accent); color: var(--color-link);"
      >
        All Years
      </a>
    </div>

    <div class="flex justify-end">
      {next && (
        <a
          href={`/christmas/${next.year}/`}
          class="flex items-center gap-1 font-medium px-3 py-1 rounded-full transition-opacity hover:opacity-80"
          style="background-color: var(--color-accent); color: var(--color-heading);"
        >
          {next.year} →
        </a>
      )}
    </div>
  </nav>

  {isCurrentSeason && (
    <>
      <VisitFacts compact />
      <p class="mb-6 text-sm brown-links" style="font-family: var(--font-sans);">
        <a href="/christmas/visit/">Plan your visit</a> &middot;
        <a href="/christmas/faq/">FAQ</a> &middot;
        <a href="/christmas/giving/">Giving back</a>
      </p>
    </>
  )}

  {heroImage && (
    <Img
      src={heroImage}
      alt={heroImageAlt ?? `Christmas ${year} at the Hormanns`}
      class="w-full rounded-lg shadow mb-6"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 896px) 100vw, 896px"
    />
  )}

  <!-- Prose intro -->
  <div class="prose max-w-none mb-6 leading-relaxed">
    <Content />
  </div>

  <!-- Videos -->
  {videos.length > 0 && (
    <>
      <h2 class="text-xl font-semibold mt-8 mb-2" style="color: var(--color-heading);">Videos</h2>
      <YouTubeGrid videos={videos} />
    </>
  )}

  <!-- Photos -->
  {photos.length > 0 && (
    <>
      <h2 class="text-xl font-semibold mt-8 mb-2" style="color: var(--color-heading);">Photos</h2>
      <PhotoGallery photos={photos} altFallback={`The Hormann Christmas light display, ${year}`} />
    </>
  )}

    <!-- Stats -->
  {stats && <StatBlock stats={stats} />}


  {yearCoverage.length > 0 && (
    <section class="mt-10">
      <h2 class="text-xl font-semibold mb-1" style="color: var(--color-heading);">In the News</h2>
      <p class="text-sm mb-3" style="color: var(--color-link); font-family: var(--font-sans);">
        Coverage of the display during the {year} season.
      </p>
      <CoverageList items={yearCoverage} showDates />
      <p class="text-sm mt-3 brown-links" style="font-family: var(--font-sans);">
        <a href="/christmas/press/">All press coverage &amp; media kit &rarr;</a>
      </p>
    </section>
  )}

  <!-- Location section (shown on all Christmas year pages) -->
  <h2 class="text-xl font-semibold mt-10 mb-2" id="house_address" style="color: var(--color-heading);">Location</h2>
  <p class="mb-2 brown-links" style="font-family: var(--font-sans);">
    Our display is located at
    <a
      href="https://goo.gl/maps/tZj7PPjBcjEFB1XM6"
      target="_blank" rel="noopener noreferrer"
    >
      6656 Devon Drive in Liberty Township, OH
    </a>
    near a number of other enjoyable holiday displays.
  </p>
  {isCurrentSeason ? (
    <DisplayMap />
  ) : (
    <p class="mb-4 text-sm brown-links" style="font-family: var(--font-sans);">
      <a href="/christmas/visit/">See the map and this season’s dates and hours →</a>
    </p>
  )}

  <div class="text-center mb-4">
    <a href={DISPLAY.coolDisplaysUrl} target="_blank" rel="noopener noreferrer">
      <img src="https://cooldisplays.net/picture.php?logo=1&width=300" alt="CoolDisplays.net" width="300" height="100" loading="lazy" style="padding:20px; display:inline;" />
    </a>
  </div>

  {showFavDisplays && <FavDisplays />}

  <!-- Bottom year navigation (duplicate of top strip) -->

  <nav class="grid grid-cols-3 items-center mt-10 pt-6 border-t text-sm" style="font-family: var(--font-sans); border-color: var(--color-accent);">
    <div>
      {prev && (
        <a
          href={`/christmas/${prev.year}/`}
          class="flex items-center gap-1 font-medium px-3 py-1 rounded-full transition-opacity hover:opacity-80 w-fit"
          style="background-color: var(--color-accent); color: var(--color-heading);"
        >
          ← {prev.year}
        </a>
      )}
    </div>

    <div class="flex justify-center">
      <a
        href="/christmas/"
        class="font-medium px-3 py-1 rounded-full border transition-opacity hover:opacity-80"
        style="border-color: var(--color-accent); color: var(--color-link);"
      >
        All Years
      </a>
    </div>

    <div class="flex justify-end">
      {next && (
        <a
          href={`/christmas/${next.year}/`}
          class="flex items-center gap-1 font-medium px-3 py-1 rounded-full transition-opacity hover:opacity-80"
          style="background-color: var(--color-accent); color: var(--color-heading);"
        >
          {next.year} →
        </a>
      )}
    </div>
  </nav>

</ChristmasLayout>

<!-- Wire up prose image links to the lightbox -->
{photos && photos.length > 0 && (
  <script define:vars={{ photoSrcs: photos.map((p, i) => ({ src: p.src.startsWith('/') || p.src.startsWith('http') ? p.src : `/${p.src}`, caption: p.caption ?? '', i })) }}>
    document.addEventListener('click', (e) => {
      const anchor = e.target.closest('.prose a');
      if (!anchor) return;
      const href = anchor.getAttribute('href');
      const match = photoSrcs.find(p => p.src === href);
      if (!match) return;
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('openLightbox', {
        detail: {
          photos: photoSrcs.map(p => ({ src: p.src, caption: p.caption })),
          index: match.i,
          opener: anchor
        }
      }));
    });
  </script>
)}

<style>
  /* Tailwind prose-like styles for the rendered Markdown content */
  :global(.prose p) { margin-bottom: 12px; }
  :global(.prose ul) { list-style-type: disc; padding-left: 1.5em; margin-bottom: 1em; }
  :global(.prose li) { margin-bottom: 0.25em; }
</style>
