---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { season, SHOW_HOURS_TEXT, yearsOfDisplay, SHOW_DEFAULTS } from '../../lib/displayYears';
import ShowStats from '../../components/ShowStats.astro';
import CoverageList from '../../components/CoverageList.astro';
import Img from '../../components/Img.astro';
import { coverage, coverageByYear, coverageSchema } from '../../lib/coverage';
import { DISPLAY, CHARITY, fullAddress, origin, absolute, breadcrumbList, touristAttraction, graph } from '../../lib/site';

const base = origin(Astro.site);
const s = season();
const heroImage = '/christmas/2025/the_hormanns_2025.jpg';

const grouped = coverageByYear();

// `value: null` means the cell is rendered specially below (live show figures).
const factSheet: { label: string; value: string | null; href?: string }[] = [
  { label: 'Display', value: DISPLAY.name },
  { label: 'Location', value: fullAddress, href: DISPLAY.mapUrl },
  { label: 'Season', value: `${s.openText} through ${s.closeText}` },
  { label: 'Hours', value: `Nightly, ${SHOW_HOURS_TEXT}` },
  { label: 'Admission', value: 'Free' },
  { label: 'Running since', value: `2001 \u2014 ${yearsOfDisplay} seasons` },
  { label: 'Scale', value: '75,805 individually controlled RGB pixels' },
  { label: 'Show length', value: null },
  { label: 'Audio', value: `Low-power FM broadcast on ${DISPLAY.fmFrequency}, plus outdoor speakers for visitors on foot` },
  { label: 'Charity', value: `${CHARITY.accepts} for ${CHARITY.beneficiary}, with the ${CHARITY.partner}` },
  { label: 'Interactive', value: 'Song voting, name texting, and a button-controlled walk-through tunnel' },
  // Link text, not a bare URL: a raw URL is one unbreakable word and forces
  // the whole page to scroll sideways on a phone.
  { label: 'Facebook', value: 'The Hormann Christmas Display', href: DISPLAY.facebookUrl },
  { label: 'Contact', value: 'Greg Hormann \u2014 ghormann@gmail.com', href: 'mailto:ghormann@gmail.com' },
];

// Counted from the content collection so the claim can never drift from what
// is actually published.
const allYears = (await getCollection('christmas', ({ data }) => !data.draft))
  .sort((a, b) => b.data.year - a.data.year);
const totalPhotos = allYears.reduce((n, y) => n + (y.data.photos?.length ?? 0), 0);
const totalVideos = allYears.reduce((n, y) => n + (y.data.videos?.length ?? 0), 0);
const latestSeason = allYears[0];

// Aerial footage is spread across several seasons, so count it rather than
// naming a year that will go stale.
const droneVideos = allYears.flatMap(y => y.data.videos.filter(v => /drone/i.test(v.title)));
const droneYears = [...new Set(
  allYears.filter(y => y.data.videos.some(v => /drone/i.test(v.title))).map(y => y.data.year),
)].sort((a, b) => a - b);

const pressPhotos = [
  {
    src: '/christmas/2025/the_hormanns_2025.jpg',
    year: 2025,
    caption: 'The full display on the 25th anniversary season. The sign at right shows the FM frequency and live power draw.',
    alt: 'The Hormann Christmas light display lit up for its 25th anniversary season, with a "25th Anniversary" message across the pixel grid',
  },
  {
    src: '/christmas/2024/the_hormanns_zoom.png',
    year: 2024,
    caption: 'The 2024 display in white, showing the arches, mini trees and the grid above the front door.',
    alt: 'Wide view of the 2024 Hormann Christmas light display in white, with arches and stars filling the front yard',
  },
  {
    src: '/christmas/2025/IMG_7581_zoom.JPG',
    year: 2025,
    caption: 'Family photos sing along on the matrix panels while the grid spells out the lyrics.',
    alt: 'The display in green and white spelling "LOVE LOVE LOVE", with singing family faces on matrix panels either side',
  },
  {
    src: '/christmas/2024/20241220_220327.jpg',
    year: 2024,
    caption: 'Inside the walk-through tunnel, where buttons let visitors change what the lights do.',
    alt: 'Two visitors standing inside the walk-through light tunnel beneath a "Naughty or Nice" sign',
  },
  {
    src: '/christmas/2025/20251222_211104.jpg',
    year: 2025,
    caption: 'The donation table. Visitors give food and cash for local food banks all season.',
    alt: 'Bags of donated groceries stacked behind a hand-painted "Donations Here" sign at the display',
  },
  {
    src: '/christmas/2025/IMG_7510_popcorn.JPG',
    year: 2025,
    caption: 'Free popcorn night — volunteers hand out popcorn to visitors under the information sign.',
    alt: 'Two volunteers sitting at a popcorn table beneath a lit sign reading "Free Popcorn Tonight"',
  },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Christmas Display', path: '/christmas/' },
];

// Press coverage is a genuine entity signal: it tells search engines this place
// is the subject of independent reporting, not just self-description.
const jsonLd = graph(
  {
    ...touristAttraction(base, absolute(base, heroImage)),
    subjectOf: coverageSchema(coverage, absolute(base, heroImage)),
  },
  breadcrumbList(base, [...crumbs, { name: 'Press', path: '/christmas/press/' }]),
);
---

<PageLayout
  title="Press & Media Kit — Hormann Christmas Light Display"
  description={`Media information for the Hormann Christmas light display in Liberty Township, Ohio — dates, hours, photos, statistics, and contact for reporters covering ${s.year} holiday displays.`}
  ogImage={heroImage}
  jsonLd={jsonLd}
>

  <Breadcrumbs crumbs={crumbs} current="Press" />

  <div class="rounded-lg px-6 py-4 mb-6 -mx-2" style="background-color: var(--color-accent);">
    <h1 class="text-3xl font-bold m-0" style="color: var(--color-heading);">Press &amp; Media</h1>
    <p class="mt-2 text-sm" style="color: var(--color-link); font-family: var(--font-sans);">
      Everything a reporter needs in one place. We're happy to host a crew — just email first.
    </p>
  </div>

  <div class="prose brown-links" style="max-width: none;">

    <h2 class="text-2xl font-bold mt-2 mb-3">Fact sheet</h2>
    <dl class="fact-sheet">
      {factSheet.map(f => (
        <div class="fact-row">
          <dt>{f.label}</dt>
          <dd>
            {f.value === null ? (
              <span data-show-stat="summary">{SHOW_DEFAULTS.minutes} minutes of music across {SHOW_DEFAULTS.songs} songs</span>
            ) : f.href ? (
              <a href={f.href} target="_blank" rel="noopener noreferrer">{f.value}</a>
            ) : (
              f.value
            )}
          </dd>
        </div>
      ))}
    </dl>

    <h2 class="text-2xl font-bold mt-8 mb-3">The story angles</h2>
    <ul>
      <li>
        <strong>A quarter century of one family's Christmas.</strong> The display started in 2001
        with two homemade parallel-port controllers running 8 circuits each. It now runs 75,805
        individually addressable pixels. <a href="/christmas/our-story/">The full history →</a>
      </li>
      <li>
        <strong>It feeds people.</strong> Visitors donate food and cash to local food banks every
        season through the {CHARITY.partner}. <a href="/christmas/giving/">Totals by year →</a>
      </li>
      <li>
        <strong>The audience runs the show.</strong> Visitors vote for the next song from their
        phones, text their names onto an 18ft × 8ft light grid over the front door, and press buttons inside a
        walk-through tunnel — 39,661 presses last season alone.
        <a href="/technology/">How it works →</a>
      </li>
      <li>
        <strong>It is all built by hand.</strong> Two weeks off work every November to install,
        and roughly an hour of programming for every 10 seconds of music.
      </li>
    </ul>

    <h2 class="text-2xl font-bold mt-8 mb-3">Photos</h2>
    <p>
      These are cleared for editorial use with credit to <strong>Greg &amp; Mary Hormann</strong>.
      Click any image for the full-resolution file.
    </p>

    <div class="press-photos not-prose">
      {pressPhotos.map(photo => (
        <figure>
          <a href={photo.src} target="_blank" rel="noopener">
            <Img src={photo.src} alt={photo.alt} sizes="(max-width: 640px) 100vw, 420px" />
          </a>
          <figcaption>
            <span class="press-photo-year">{photo.year}</span>
            {photo.caption}
          </figcaption>
        </figure>
      ))}
    </div>

    <p>
      More is available: our <a href="/pictures/">photo galleries</a> hold {totalPhotos} photos
      across every season, and the <a href="/christmas/">season pages</a> link {totalVideos}
      videos &mdash; individual songs, day-by-day setup and takedown, and
      {' '}{droneVideos.length} aerial drone shots of the show across
      {' '}{droneYears.length} seasons between {droneYears[0]} and
      {' '}{droneYears[droneYears.length - 1]}. The
      <a href={`/christmas/${latestSeason.data.year}/`}> {latestSeason.data.year} season page</a>
      {' '}alone has {latestSeason.data.videos.length}. Email us if you need something specific
      that isn't here.

    </p>

    <h2 class="text-2xl font-bold mt-8 mb-3">Coverage</h2>
    <p>
      Local stations have broadcast live from the display, and we're regularly included in the
      area's holiday lights round-ups and community pages.
    </p>

    {grouped.map(({ year, items }) => (
      <section class="mt-5">
        <h3 class="text-base font-semibold mb-2" style="color: var(--color-heading); font-family: var(--font-sans);">
          <a href={`/christmas/${year}/`} class="brown-links">{year}</a>
        </h3>
        <CoverageList items={items} showDates />
      </section>
    ))}

    <p class="text-sm mt-5" style="opacity: 0.85;">
      Written about the display and don't see it here?
      <a href="mailto:ghormann@gmail.com">Send us the link</a> and we'll add it.
    </p>

    <ShowStats />

    <h2 class="text-2xl font-bold mt-8 mb-3">Contact</h2>
    <p>
      Greg Hormann — <a href="mailto:ghormann@gmail.com">ghormann@gmail.com</a>.
      For visiting details, see <a href="/christmas/visit/">Plan Your Visit</a>.
    </p>

  </div>

</PageLayout>

<style>
  .press-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin: 1.25rem 0 1.5rem;
  }

  .press-photos figure {
    margin: 0;
  }

  .press-photos img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    border-radius: 0.5rem;
    display: block;
    background-color: var(--color-card-bg);
  }

  .press-photos figcaption {
    margin-top: 0.4rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-link);
  }

  .press-photo-year {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.35rem;
    border-radius: 0.25rem;
    font-weight: 600;
    background-color: var(--color-accent);
    color: var(--color-heading);
  }

  .fact-sheet {
    margin: 0 0 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
  }

  .fact-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-accent);
  }

  .fact-row dt {
    font-weight: 600;
    color: var(--color-heading);
  }

  .fact-row dd {
    margin: 0;
    /* Long values (URLs, addresses) must wrap rather than widen the page. */
    overflow-wrap: anywhere;
  }

  /* Phones: stack label above value so neither column is squeezed. */
  @media (max-width: 520px) {
    .fact-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }
</style>
