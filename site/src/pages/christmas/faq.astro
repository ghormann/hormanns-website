---
import PageLayout from '../../layouts/PageLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ShowStats from '../../components/ShowStats.astro';
import { yearsOfDisplay } from '../../lib/displayYears';
import { DISPLAY, origin, breadcrumbList, touristAttraction, graph } from '../../lib/site';
import { getFaqs, FAQ_API_URL } from '../../lib/faq';

const base = origin(Astro.site);

// The questions and answers are owned by vote-now.org so the display's app and
// this page always say the same thing. They are fetched at build time (which is
// what feeds the FAQPage structured data below) and refreshed in the browser.
const faqs = await getFaqs();

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Christmas Display', path: '/christmas/' },
];

const stripTags = (html: string) =>
  html.replace(/<[^>]*>/g, '')
    .replace(/&mdash;/g, '—').replace(/&ndash;/g, '–')
    .replace(/&rsquo;/g, '’').replace(/&ldquo;/g, '“').replace(/&rdquo;/g, '”');

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${base}/christmas/faq/#faq`,
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: stripTags(f.answer) },
  })),
};

const jsonLd = graph(
  faqPage,
  touristAttraction(base),
  breadcrumbList(base, [...crumbs, { name: 'FAQ', path: '/christmas/faq/' }]),
);

const description = `Answers to common questions about visiting ${DISPLAY.name} in Liberty Township, Ohio — hours, dates, the ${DISPLAY.fmFrequency} radio station, parking, donations, and how ${yearsOfDisplay} years of lights actually work.`;
---

<PageLayout
  title="Christmas Lights FAQ — Hours, Radio Station & Directions | The Hormanns"
  description={description}
  jsonLd={jsonLd}
>

  <Breadcrumbs crumbs={crumbs} current="FAQ" />

  <div class="rounded-lg px-6 py-4 mb-6 -mx-2" style="background-color: var(--color-accent);">
    <h1 class="text-3xl font-bold m-0" style="color: var(--color-heading);">Frequently Asked Questions</h1>
    <p class="mt-2 text-sm" style="color: var(--color-link); font-family: var(--font-sans);">
      Planning a visit? Start with <a href="/christmas/visit/" style="text-decoration: underline;">Plan Your Visit</a>.
    </p>
  </div>

  <div class="space-y-3" id="faq-list">
    {faqs.map((f, i) => (
      <details class="group rounded-lg overflow-hidden" style="background-color: var(--color-card-bg);" open={i < 3} data-faq-id={f.id}>
        <summary
          class="cursor-pointer list-none px-4 py-3 font-semibold flex items-start justify-between gap-3"
          style="color: var(--color-heading); font-family: var(--font-sans);"
        >
          <h2 class="text-base font-semibold m-0" data-faq-question>{f.question}</h2>
          <span class="shrink-0 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <div class="px-4 pb-4 leading-relaxed brown-links" data-faq-answer set:html={f.answer} />
      </details>
    ))}
  </div>

  <p class="mt-8 brown-links" style="font-family: var(--font-sans);">
    Still stuck? <a href={DISPLAY.facebookUrl} target="_blank" rel="noopener noreferrer">Ask on Facebook</a>
    or <a href="mailto:ghormann@gmail.com">email us</a> — we read everything.
  </p>

  <ShowStats />

  <!--
    The page was built from vote-now.org's FAQ, which is what search engines
    read. Once it loads, ask again so anything edited since the last deploy —
    or any figure that has moved on — is current. If the request fails the
    built-in text simply stands.
  -->
  <script is:inline define:vars={{ apiUrl: FAQ_API_URL }}>
    (function () {
      var list = document.getElementById('faq-list');
      if (!list) return;

      var template = list.querySelector('details');
      if (!template) return;

      function build(faq) {
        var el = template.cloneNode(true);
        el.open = false;
        fill(el, faq);
        return el;
      }

      function fill(el, faq) {
        el.setAttribute('data-faq-id', faq.id);
        el.querySelector('[data-faq-question]').textContent = faq.question;
        el.querySelector('[data-faq-answer]').innerHTML = faq.answer;
      }

      fetch(apiUrl)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          var faqs = data && data.faqs;
          if (!Array.isArray(faqs) || faqs.length === 0) return;

          var existing = {};
          list.querySelectorAll('[data-faq-id]').forEach(function (el) {
            existing[el.getAttribute('data-faq-id')] = el;
          });

          faqs.forEach(function (faq, i) {
            var el = existing[faq.id];
            if (el) {
              fill(el, faq);
              delete existing[faq.id];
            } else {
              el = build(faq);
            }
            // Re-append in API order; moving a node in place is a no-op.
            list.appendChild(el);
            if (i < 3 && !el.dataset.touched) el.open = true;
          });

          // Anything the API no longer carries has been retired.
          Object.keys(existing).forEach(function (id) { existing[id].remove(); });
        })
        .catch(function () {
          /* Keep the text rendered at build time. */
        });

      list.addEventListener('toggle', function (e) {
        if (e.target.tagName === 'DETAILS') e.target.dataset.touched = '1';
      }, true);
    })();
  </script>

</PageLayout>
