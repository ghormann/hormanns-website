---
import PageLayout from '../layouts/PageLayout.astro';
import RecentDisplays from '../components/RecentDisplays.astro';
import YouTubeGrid from '../components/YouTubeGrid.astro';
import FavDisplays from '../components/FavDisplays.astro';
import VisitFacts from '../components/VisitFacts.astro';
import ShowStats from '../components/ShowStats.astro';
import Img from '../components/Img.astro';
import { yearsOfDisplayWords, season, SHOW_DEFAULTS, inVisitWindow } from '../lib/displayYears';
import { DISPLAY, origin, absolute, touristAttraction, breadcrumbList, person, graph } from '../lib/site';

const historyVideo = [{ id: 'Nd7ADGezo3s', title: 'Video History of our Display' }];

// Canonical host comes from astro.config.mjs (`site`) so structured data can never
// drift from the canonical/sitemap URLs.
const siteBase = origin(Astro.site);
const s = season();
const homeImage = '/christmas/2025/the_hormanns_2025.jpg';

const websiteJsonLd = graph(
  {
    '@type': 'WebSite',
    '@id': `${siteBase}/#website`,
    name: 'The Hormanns',
    url: `${siteBase}/`,
    description:
      `Greg and Mary Hormann of Liberty Township, Ohio — home of ${DISPLAY.name}, a free animated Christmas light display running since 2001.`,
  },
  touristAttraction(siteBase, absolute(siteBase, homeImage)),
  person(siteBase, 'Greg Hormann', 'greg'),
  person(siteBase, 'Mary Hormann', 'mary'),
  breadcrumbList(siteBase, [{ name: 'Home', path: '/' }]),
);
---

<PageLayout
  title="Greg and Mary Hormann — Liberty Township, Ohio"
  description={`The personal website of Greg and Mary Hormann — family, ${DISPLAY.name}, and technology in Liberty Township, Ohio (Cincinnati area).`}
  ogImage="/christmas/2025/the_hormanns_2025.jpg"
  jsonLd={websiteJsonLd}
>

  <!-- Hero heading -->
  <div class="rounded-lg px-6 py-4 mb-8 -mx-2" style="background-color: var(--color-accent);">
    <h1 class="text-3xl font-bold m-0" style="color: var(--color-heading);">Meet Greg and Mary Hormann</h1>
  </div>

  <!--
    Visit call to action: the question most first-time visitors arrive with,
    but only relevant from October through mid-January. The initial state is
    decided at build time so there is no flash and it still behaves without
    JavaScript; the inline script below re-checks on load so a stale build
    can't leave it showing in July.
  -->
  <section id="visit-cta" class="mb-10" hidden={!inVisitWindow()}>
    <h2 class="text-xl font-semibold mb-3" style="color: var(--color-heading);">Come See the Lights</h2>
    <VisitFacts compact />
    <p class="brown-links text-sm" style="font-family: var(--font-sans);">
      <a href="/christmas/visit/"><strong>Plan your visit</strong></a> &middot;
      <a href="/christmas/faq/">FAQ</a> &middot;
      <a href="/christmas/giving/">Giving back</a>
    </p>
  </section>

  <script is:inline>
    // Keep in sync with inVisitWindow() in src/lib/displayYears.ts.
    (function () {
      var el = document.getElementById('visit-cta');
      if (!el) return;
      var now = new Date();
      var m = now.getMonth();
      el.hidden = !(m >= 9 || (m === 0 && now.getDate() <= 15));
    })();
  </script>

  <!-- Christmas display section -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
    <div class="sm:col-span-2 brown-links">
      <h2 class="text-xl font-semibold mb-3" style="color: var(--color-heading);">Christmas Display</h2>
      <p class="leading-relaxed mb-3">
        Both of us are big on <a href="/christmas/">Christmas</a>.
        Mary likes the shopping and interior decorating, and Greg is big on outside Christmas displays.
        In <a href="/christmas/2001/">2001</a>, Greg
        started experimenting with animated displays controlled by a computer. {yearsOfDisplayWords} years later, we have over 75,000 lights synchronized to 
        <span data-show-stat="summary">{SHOW_DEFAULTS.minutes} minutes of music across {SHOW_DEFAULTS.songs} songs</span> leveraging <a href="https://xlights.org" target="_blank" rel="noopener noreferrer">xLights</a>,
        <a href="https://github.com/FalconChristmas/fpp" target="_blank" rel="noopener noreferrer">FPP</a>,
        and <a href="/technology/dmx/">pixels controlled by E1.31</a>.
        Tune to {DISPLAY.fmFrequency} when you visit to hear the show.
        If you are curious about the history of our display, we've captured <a href="/christmas/our-story/">our story</a>
        which is also summarized in a <a href="https://www.youtube.com/watch?v=Nd7ADGezo3s">2021 on stage presentation</a>.
      </p>
      <p id="car-count" class="leading-relaxed mb-3" hidden></p>
      <RecentDisplays />
    </div>
    <div>
      <a href="/christmas/">
        <img
          class="rounded-lg shadow w-full mb-4"
          src="https://cooldisplays.net/picture.php?v=1764536045&pictid=278&width=400"
          alt={DISPLAY.name}
        />
      </a>
      <YouTubeGrid videos={historyVideo} cols={1} />
    </div>
  </div>

  <!-- About section -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
    <div class="sm:col-span-2 brown-links">
      <p class="leading-relaxed mb-4">
        <a href="/greg/">Greg</a> and
        <a href="/mary/">Mary</a> became
        friends in high school at
        <a href="http://www.wawasee.k12.in.us/">Wawasee High School</a>
        in Syracuse, IN. Both separately decided to attend
        <a href="http://www.iub.edu">Indiana University</a>
        in Bloomington, Indiana. Greg and Mary began dating during their freshman year, and both
        ended up moving to Cincinnati after college. On November 4, 2000 — exactly 6 years from
        their first date — the couple were wed at All Saints Catholic Church in Cincinnati, Ohio.
      </p>
    </div>
    <div class="flex justify-center items-start">
      <Img
        src="/wedding/reception/_greg_mary_dancing.jpg"
        alt="Greg and Mary Hormann dancing at their wedding reception"
        class="rounded-lg shadow max-h-48 object-cover"
      />
    </div>
  </div>

  <!-- More section -->
  <h2 class="text-lg font-semibold mt-10 mb-2" style="color: var(--color-heading);">Looking for more?</h2>
  <p class="text-sm brown-links" style="font-family: var(--font-sans);">
    Check out the <a href="/sitemap/">site map</a>
    to learn about everything this site has to offer.
  </p>

  <FavDisplays wide />

  <ShowStats />

  <script>
    // Live car count for visitors deciding whether to head over right now.
    fetch('https://vote-now.org/api/model')
      .then((res) => res.json())
      .then((data) => {
        const totalCars = data?.model?.cars?.['total-cars'];
        const carEl = document.getElementById('car-count');
        if (carEl && typeof totalCars === 'number' && totalCars > 0) {
          carEl.textContent =
            totalCars === 1
              ? 'Right now, we estimate 1 car is parked outside watching our display!'
              : `Right now, we estimate ${totalCars} cars are parked outside watching our display!`;
          carEl.hidden = false;
        }
      })
      .catch(() => {
        // Leave the page as rendered if the request fails.
      });
  </script>

</PageLayout>
